# Local development settings for scripts/analysis/compare_fingerprints.sh
# Copy to scripts/dev/compare_fingerprints.env and edit values.

COHORT_DIR=/cluster/projects/mohccn/external_PANCAN/PANCAN-H_CHANGE/Oncoanalyser
OUTPUT_DIR=/cluster/projects/mohccn/external_PANCAN/PANCAN-H_CHANGE/Oncoanalyser/fingerprint_metrics_dev

# true|false
DRY_RUN=true
DISCOVER_ONLY=true
TRACE=false

# Set to 0 for no limit, or a small number (e.g. 5) for stepwise testing.
PAIR_LIMIT=5
