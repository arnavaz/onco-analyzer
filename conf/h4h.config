/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        H4H (UHN HPC) cluster config for nf-core/oncoanalyser
        Executor: SLURM
        Container: Singularity 4.3.2
        Cluster partitions (current policy):
            all         30 GB RAM max   5-day limit
            short        8 GB RAM max   interactive only
            himem       60 GB RAM max   7-day limit
            long        30 GB RAM max  21-day limit
            veryhimem   site-managed
            superhimem  1.4 TB RAM max  5-day limit (restricted)
            pughlab     private nodes, 21-day limit, high-memory workloads
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ---------------------------------------------------------------------------
// Singularity settings
// ---------------------------------------------------------------------------
singularity {
    enabled      = true
    autoMounts   = true
    // Cache pulled SIF images here so they're shared across runs
    cacheDir     = '/cluster/projects/pughlab/references/oncoanalyser_resources/singularity_cache'
    // Whitelist temporary directory environment variables
    envWhitelist = 'TMPDIR,TEMP,TMP,SINGULARITY_TMPDIR,APPTAINER_TMPDIR'
    // Older Singularity (3.x) needs explicit binary path when not in $PATH
    // If `singularity` is in your PATH via the module, this line can be removed
    // singularity.executable = '/cluster/tools/software/rocky9/singularity/4.3.2/bin/singularity'
}

// Helper to respect ONCO_SLURM_QUEUE environment variable if set
def getQueue = { default_queue ->
    def env_q = System.getenv('ONCO_SLURM_QUEUE')
    if (env_q) {
        if (env_q == 'pughlab') {
            return 'pughlab,himem,all'
        } else if (env_q == 'superhimem') {
            return (task.memory && task.memory >= 120.GB) ? 'superhimem,pughlab,himem' : 'pughlab,himem,all'
        } else if (env_q == 'himem') {
            return (task.memory && task.memory > 60.GB) ? 'pughlab,superhimem' : 'himem,all'
        } else if (env_q == 'long') {
            return (task.memory && task.memory > 30.GB) ? (task.memory > 60.GB ? 'pughlab' : 'himem') : 'long'
        }
        return env_q
    }
    return default_queue
}

// ---------------------------------------------------------------------------
// SLURM executor
// ---------------------------------------------------------------------------
process {
    executor       = 'slurm'
    // Default partition — adjust to match your cluster's available partitions
    // Common H4H partitions: himem, all, long, debug
    queue          = { getQueue('all') }

    // Direct temporary scratch to task working directory to protect node /tmp from exhaustion
    beforeScript   = 'mkdir -p ./tmp && export TMPDIR="${PWD}/tmp" TEMP="${PWD}/tmp" TMP="${PWD}/tmp"'
    env = [
        TMPDIR: '${PWD}/tmp',
        TEMP:   '${PWD}/tmp',
        TMP:    '${PWD}/tmp',
        SINGULARITYENV_TMPDIR: '${PWD}/tmp',
        SINGULARITYENV_TEMP:   '${PWD}/tmp',
        SINGULARITYENV_TMP:    '${PWD}/tmp'
    ]
    // Account selection precedence:
    // 1) ONCO_SLURM_ACCOUNT exported by run_oncoanalyser.sh
    // 2) default to pughlab for tasks routed to queue=pughlab
    clusterOptions = {
        if (task.queue && task.queue.contains('pughlab')) {
            return '--account=pughlab'
        }
        def account = System.getenv('ONCO_SLURM_ACCOUNT')
        if (account) {
            return "--account=${account}"
        }
        return ''
    }

    // Retry on common HPC exit codes (OOM, timeout, node failure, Java OOM exit 1/135/140)
    errorStrategy  = { task.exitStatus in [1, 104, 130, 134, 135, 137, 139, 140, 143, 175] ? 'retry' : 'finish' }
    maxRetries     = 3
    maxErrors      = '-1'

    // ---------------------------------------------------------------------------
    // Per-label resource overrides (matching oncoanalyser process labels)
    //
    // Partition routing rationale:
    //   all      <=30 GB jobs
    //   himem    <=60 GB jobs
    //   long     <=30 GB jobs that need longer wall-time
    //   pughlab  >60 GB and/or high-memory retries (private nodes)
    //
    // Memory scaling: closures cap values so retries never exceed the target partition.
    // Queue routing: closures promote to a larger partition when memory crosses thresholds.
    // ---------------------------------------------------------------------------
    withLabel: process_single {
        cpus   = 1
        memory = { [4.GB * task.attempt, 16.GB].min() }
        time   = { 4.h  * task.attempt }
        queue  = { getQueue('all') }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { [8.GB * task.attempt, 24.GB].min() }
        time   = { 4.h   * task.attempt }
        queue  = { getQueue('all') }
    }
    withLabel: process_medium {
        cpus   = 6
        memory = { [24.GB * task.attempt, 56.GB].min() }
        time   = { 8.h   * task.attempt }
        queue  = { getQueue(task.memory > 30.GB ? 'himem' : 'all') }
    }
    withName: /.*BWAMEM2_ALIGN.*/ {
        // BWA-mem2 GRCh38 2bit index is ~32 GB; route directly to himem (<=60 GB) to prevent initial OOM.
        cpus      = { task.attempt == 1 ? 8 : 12 }
        memory    = { [40.GB * task.attempt, 56.GB].min() }
        time      = { 8.h * task.attempt }
        queue     = { getQueue('himem') }
    }
    withName: /.*ESVEE.*/ {
        // HMF structural variant caller (high Java heap requirements for WGS)
        cpus   = 8
        memory = { [56.GB * task.attempt, 160.GB].min() }
        time   = { [16.h * task.attempt, 48.h].min() }
        queue  = { getQueue(task.memory > 30.GB ? (task.memory > 60.GB ? 'pughlab' : 'himem') : 'all') }
    }
    withName: /.*SAGE_SOMATIC.*/ {
        // Somatic variant calling
        cpus   = 8
        memory = { [40.GB * task.attempt, 120.GB].min() }
        time   = { [16.h * task.attempt, 48.h].min() }
        queue  = { getQueue(task.memory > 30.GB ? (task.memory > 60.GB ? 'pughlab' : 'himem') : 'all') }
    }
    withName: /.*VIRUSBREAKEND.*/ {
        cpus   = 8
        memory = { [30.GB * task.attempt, 60.GB].min() }
        time   = { 16.h * task.attempt }
        queue  = { getQueue(task.memory > 30.GB ? 'himem' : 'all') }
    }
    withName: /.*TEAL_PIPELINE.*/ {
        cpus   = 6
        memory = { [24.GB * task.attempt, 56.GB].min() }
        time   = { 8.h * task.attempt }
        queue  = { getQueue(task.memory > 30.GB ? 'himem' : 'all') }
    }
    withName: /^(AMBER|BAMTOOLS|COBALT|CIDER)$/ {
        // Docs suggest these are often viable around 24 GB; keep first attempt on all.
        cpus   = 12
        memory = { task.attempt == 1 ? 24.GB : [40.GB * task.attempt, 56.GB].min() }
        time   = { 8.h * task.attempt }
        queue  = { getQueue(task.attempt == 1 ? 'all' : 'himem') }
    }
    withName: /^(CHORD|CUPPA|LINX_.*|ORANGE|WISP)$/ {
        // Lightweight/moderate tools should prefer all for throughput.
        cpus   = 8
        memory = { task.attempt == 1 ? 16.GB : [24.GB * task.attempt, 40.GB].min() }
        time   = { 8.h * task.attempt }
        queue  = { getQueue(task.attempt == 1 ? 'all' : 'himem') }
    }
    withName: 'PURPLE' {
        // Boost initial memory for tumor-only VCF load, scale up to pughlab private nodes
        cpus   = 8
        memory = { [56.GB * task.attempt, 120.GB].min() }
        time   = { 12.h * task.attempt }
        queue  = { getQueue(task.memory > 30.GB ? (task.memory > 60.GB ? 'pughlab' : 'himem') : 'all') }
    }
    withName: /^(PEACH|VIRUSINTERPRETER)$/ {
        cpus   = 2
        memory = { task.attempt == 1 ? 8.GB : [16.GB * task.attempt, 24.GB].min() }
        time   = { 4.h * task.attempt }
        queue  = { getQueue('all') }
    }
    withLabel: process_high {
        // High CPU/high memory tasks; route to pughlab if >60 GB
        cpus   = 12
        memory = { [48.GB * task.attempt, 160.GB].min() }
        time   = { 16.h  * task.attempt }
        queue  = { getQueue(task.memory > 60.GB ? 'pughlab' : 'himem') }
    }
    withLabel: process_long {
        // Long-running jobs: keep on long only when memory fits long partition
        time   = { 48.h * task.attempt }
        queue  = { getQueue(task.memory > 30.GB ? 'pughlab' : 'long') }
    }
    withLabel: process_medium_memory {
        // Medium-memory tasks: himem for <=60 GB, pughlab above that
        cpus   = 6
        memory = { [40.GB * task.attempt, 120.GB].min() }
        time   = { 8.h   * task.attempt }
        queue  = { getQueue(task.memory > 60.GB ? 'pughlab' : 'himem') }
    }
    withLabel: process_high_memory {
        // GRIDSS and other high-memory tools always run on pughlab private nodes
        cpus   = 12
        memory = { [80.GB * task.attempt, 300.GB].min() }
        time   = { 24.h  * task.attempt }
        queue  = { getQueue('pughlab') }
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

// ---------------------------------------------------------------------------
// Nextflow executor pacing
// Dependencies are already enforced by the workflow DAG/channels, so let
// SLURM decide when ready tasks actually start instead of rate-limiting submits.
// ---------------------------------------------------------------------------
executor {
    name           = 'slurm'
    queueSize      = 0      // unlimited: let Nextflow hand all ready tasks to SLURM
    pollInterval   = '2 min'    // how often Nextflow polls SLURM for job status
    // Increase if you hit "too many open files" on large runs
    // jobName        = { task.name.replace(' ', '_') }
}

report {
    overwrite = true
}

timeline {
    overwrite = true
}

trace {
    overwrite = true
}

dag {
    overwrite = true
}

// ---------------------------------------------------------------------------
// Singularity registry (already set in nextflow.config but explicit here)
// ---------------------------------------------------------------------------
singularity.registry = 'quay.io'

// ---------------------------------------------------------------------------
// Pre-staged reference data (populated by --prepare_reference_only)
// Update the version tag (e.g. 2.3.0) if you re-stage after a pipeline update
// ---------------------------------------------------------------------------
params {
    genome          = 'GRCh38_hmf'
    igenomes_ignore = true

    if (params.genome == 'GRCh37_hmf') {
        ref_data_hmf_data_path    = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh37/hmf_pipeline_resources.37_v2.3.0--2'
        ref_data_genome_fasta     = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh37/Homo_sapiens.GRCh37.GATK.illumina.fasta'
        ref_data_genome_fai       = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh37/Homo_sapiens.GRCh37.GATK.illumina.fasta.fai'
        ref_data_genome_dict      = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh37/Homo_sapiens.GRCh37.GATK.illumina.fasta.dict'
        ref_data_genome_img       = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh37/Homo_sapiens.GRCh37.GATK.illumina.fasta.img'
        ref_data_panel_data_path  = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh37/hmf_panel_resources.tso500.37_v2.3.0--2'
    } else {
        ref_data_base                 = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/3.1.0'
        ref_data_genomes_base         = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0'
        hmf_genomes_base              = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0'
        ref_data_hmf_data_path        = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/3.1.0/hmf_pipeline_resources.38_v3.1.0--1'
        ref_data_genome_fasta         = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh38_masked_exclusions_alts_hlas.fasta'
        ref_data_genome_fai           = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh38_masked_exclusions_alts_hlas.fasta.fai'
        ref_data_genome_dict          = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh38_masked_exclusions_alts_hlas.fasta.dict'
        ref_data_genome_img           = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/GRCh38_masked_exclusions_alts_hlas.fasta.img'
        ref_data_genome_bwamem2_index = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/bwa-mem2_index-2.2.1'
        ref_data_genome_gridss_index  = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/gridss_index-2.13.2'
        ref_data_genome_star_index    = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/star_index-gencode_38-2.7.3a'
        ref_data_panel_data_path      = '/cluster/projects/pughlab/references/oncoanalyser_resources/oncoanalyser_refs/reference_data/2.3.0/hmf_panel_resources.tso500.38_v2.3.0--2'
    }

    hmf_data_paths {
        '37' {
            sigs_etiology = "${projectDir}/../conf/signatures_etiology.tsv"
        }
        '38' {
            sigs_etiology = "${projectDir}/../conf/signatures_etiology.tsv"
        }
    }
}
